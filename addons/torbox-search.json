{
  "id": "torbox-search",
  "name": "TorBox Search",
  "version": "1.0.0",
  "description": "Searches TorBox's own index for the book you're looking at. Uses the TorBox key already saved in AudioYam; results marked cached play instantly.",
  "contentType": "",
  "rateLimit": { "requestsPerMinute": 20 },
  "matching": { "threshold": 0.5 },
  "adapters": {
    "source": {
      "request": {
        "method": "GET",
        "url": "https://search-api.torbox.app/torrents/search/{QUERY}?metadata=false&check_cache=true&check_owned=false",
        "headers": { "Authorization": "Bearer {TORBOX_KEY}" },
        "timeout": 30000
      },
      "response": {
        "resultsPath": "data.torrents",
        "mapping": {
          "title": "raw_title",
          "magnetUrl": "magnet",
          "infoHash": "hash",
          "sizeBytes": "size",
          "seeders": "last_known_seeders",
          "debridCache": "cached"
        }
      }
    }
  }
}
